{
  "opencollection": "1.0.0",
  "info": {
    "name": "EZRentOut Assets Members API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Members",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List members",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/members.api",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated list results (default 1)."
              }
            ]
          },
          "docs": "List members"
        },
        {
          "info": {
            "name": "Create a member",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.ezrentout.com/members.api",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a member"
        },
        {
          "info": {
            "name": "Get member details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/members/:userId.api",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The member (user) ID."
              }
            ]
          },
          "docs": "Get member details"
        },
        {
          "info": {
            "name": "Update a member",
            "type": "http"
          },
          "http": {
            "method": "PATCH",
            "url": "https://{subdomain}.ezrentout.com/members/:userId.api",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The member (user) ID."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update a member"
        },
        {
          "info": {
            "name": "List a member's checked-out items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/members/:userId/checked_out_items.api",
            "params": [
              {
                "name": "userId",
                "value": "",
                "type": "path",
                "description": "The member (user) ID."
              }
            ]
          },
          "docs": "List a member's checked-out items"
        }
      ]
    }
  ],
  "bundled": true
}