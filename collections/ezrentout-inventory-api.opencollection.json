{
  "opencollection": "1.0.0",
  "info": {
    "name": "EZRentOut Assets Inventory API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Inventory",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List inventory items",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/inventory.api",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated list results (default 1)."
              }
            ]
          },
          "docs": "List inventory items"
        },
        {
          "info": {
            "name": "Create an inventory item",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.ezrentout.com/inventory.api",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an inventory item"
        },
        {
          "info": {
            "name": "Get inventory item details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/inventory/:assetNum.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ]
          },
          "docs": "Get inventory item details"
        },
        {
          "info": {
            "name": "Update an inventory item",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://{subdomain}.ezrentout.com/inventory/:assetNum.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an inventory item"
        },
        {
          "info": {
            "name": "Delete an inventory item",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://{subdomain}.ezrentout.com/inventory/:assetNum.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ]
          },
          "docs": "Delete an inventory item"
        },
        {
          "info": {
            "name": "Transfer inventory stock between locations",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.ezrentout.com/inventory/:assetNum/transfer_stock.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Transfer inventory stock between locations"
        },
        {
          "info": {
            "name": "List stock assets",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/stock_assets.api",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated list results (default 1)."
              }
            ]
          },
          "docs": "List stock assets"
        },
        {
          "info": {
            "name": "Create a stock asset",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.ezrentout.com/stock_assets.api",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a stock asset"
        }
      ]
    }
  ],
  "bundled": true
}