{
  "opencollection": "1.0.0",
  "info": {
    "name": "EZRentOut Assets Bundles API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Bundles",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List bundles",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/bundles.api",
            "params": [
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "Page number for paginated list results (default 1)."
              }
            ]
          },
          "docs": "List bundles"
        },
        {
          "info": {
            "name": "Create a bundle",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://{subdomain}.ezrentout.com/bundles.api",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create a bundle"
        },
        {
          "info": {
            "name": "Get bundle details",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/bundles/:bundleId.api",
            "params": [
              {
                "name": "bundleId",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "Get bundle details"
        }
      ]
    }
  ],
  "bundled": true
}