{
  "opencollection": "1.0.0",
  "info": {
    "name": "EZRentOut Assets Availability API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "token",
      "value": "{{token}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Availability",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get item quantity by location",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/locations/get_quantity_by_location.api",
            "params": [
              {
                "name": "asset_id",
                "value": "",
                "type": "query"
              }
            ]
          },
          "docs": "Returns available quantity of items broken down by location."
        },
        {
          "info": {
            "name": "Get booked dates for an asset",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/assets/:assetNum/booked_dates.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ]
          },
          "docs": "Returns the reserved (booked) date ranges for an asset so integrations can avoid double-booking."
        },
        {
          "info": {
            "name": "Get booked dates for an inventory item",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{subdomain}.ezrentout.com/inventory/:assetNum/booked_dates.api",
            "params": [
              {
                "name": "assetNum",
                "value": "",
                "type": "path",
                "description": "The asset / inventory item number."
              }
            ]
          },
          "docs": "Get booked dates for an inventory item"
        }
      ]
    }
  ],
  "bundled": true
}